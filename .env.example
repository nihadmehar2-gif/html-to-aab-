# ============================================================
# Web2APK Studio — SERVER-SIDE environment variables
# These are read ONLY by the /api serverless functions.
# NEVER expose these values to the frontend or commit this file.
# ============================================================

# GitHub Personal Access Token (fine-grained, least privilege):
#   Repository access: ONLY the build repository below
#   Permissions: Contents: Read and write | Actions: Read and write | Metadata: Read
# Create at: https://github.com/settings/personal-access-tokens/new
GH_TOKEN=

# GitHub repository that stores encrypted job payloads and runs android-build.yml
GH_OWNER=nihadmehar2-gif
GH_REPO=html-to-aab-

# Branch used as the encrypted job store (created automatically on first build)
JOBS_BRANCH=jobs

# Max upload size in MB (raw file). Keep small on Vercel Hobby (request body limit ~4.5MB).
# Recommended: 3 for Vercel, 5 for Netlify.
MAX_UPLOAD_MB=3

# Artifact retention in days (counts against GitHub Actions storage quota)
ARTIFACT_RETENTION_DAYS=14

# Optional CORS allow-list, comma separated. Use * to allow all origins.
ALLOWED_ORIGIN=*

# Pinned Capacitor major version used by the build workflow
CAPACITOR_VERSION=6
